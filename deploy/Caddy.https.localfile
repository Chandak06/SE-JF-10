{
    skip_install_trust
}
https://localhost:8443 {
    tls internal
    @backend path /api/* /ready /health
    handle @backend {
        reverse_proxy backend:5000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
