NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/csmq
CLIENT_ORIGIN=http://localhost:5173
SESSION_TTL_MINUTES=60
BCRYPT_ROUNDS=12
# Only set this to the exact trusted reverse-proxy IP/CIDR in deployment.
# The proxy must replace, not append user-supplied X-Forwarded-* headers.
TRUST_PROXY=
MAX_UPLOAD_BYTES=10485760
